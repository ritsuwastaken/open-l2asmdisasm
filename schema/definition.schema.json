{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "l2asmdisasm binary definition",
  "oneOf": [
    {
      "$ref": "#/$defs/layout"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/layout"
          },
          {
            "required": [
              "clients"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\t\\r\\n]+$"
        },
        "type": {
          "enum": [
            "u32",
            "i32",
            "u16",
            "i16",
            "u8",
            "i8",
            "f32",
            "utf16",
            "string",
            "compact",
            "padding",
            "i64",
            "f64",
            "group"
          ]
        },
        "count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "enabledBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          },
          "else": {
            "not": {
              "required": [
                "fields"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "padding"
              }
            }
          },
          "then": {
            "required": [
              "size"
            ],
            "not": {
              "required": [
                "count"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "size"
              ]
            }
          }
        }
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": -9223372036854776000,
          "maximum": 9223372036854776000
        },
        "mask": {
          "type": "integer",
          "minimum": -9223372036854776000,
          "maximum": 9223372036854776000
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "recordCount": {
          "oneOf": [
            {
              "enum": [
                "u32",
                "compact",
                "eof"
              ]
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "object",
              "required": [
                "nonzero"
              ],
              "additionalProperties": false,
              "properties": {
                "nonzero": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "trailer": {
          "type": "boolean",
          "default": true
        },
        "magic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        }
      }
    }
  }
}
